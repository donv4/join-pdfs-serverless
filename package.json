{
	"name": "join-pdfs-serverless",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build && npm run copy-libs",
		"copy-libs": "xcopy /E /I /Y public\\js\\lib dist\\js\\lib",
		"preview": "astro build && astro preview",
		"astro": "astro",
		"generate-types": "wrangler types",
