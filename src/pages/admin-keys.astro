---
// src/pages/admin-keys.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Premium Keys Admin | Join-PDFs">
    <div class="container py-5" style="background: rgba(255,255,255,0.9); border-radius: 12px; margin-top: 40px; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
        <h1 class="mb-4 text-primary"><i class="fas fa-user-shield"></i> Premium Keys Admin</h1>
        <p class="lead text-muted">View and manage active premium keys dynamically via Cloudflare KV database blocks.</p>
        
        <!-- Active Keys Section -->
        <div class="card shadow-sm border-0 mb-5">
            <div class="card-body">
                <h5 class="card-title mb-3 fw-bold text-secondary">
                    <i class="fas fa-key"></i> Active Keys (<span id="active-count">0</span>)
                </h5>
                <div id="active-keys-container" class="table-responsive d-none">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Key</th>
                                <th>Plan</th>
                                <th>Email</th>
                                <th>Created</th>
                                <th>Expiry</th>
                                <th>Used</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="active-keys-body"></tbody>
                    </table>
                </div>
                <div id="active-keys-empty" class="alert alert-warning m-0">
                    <i class="fas fa-exclamation-triangle"></i> Loading active keys...
                </div>
            </div>
        </div>

        <!-- Pending Purchases Section -->
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h5 class="card-title mb-3 fw-bold text-secondary">
                    <i class="fas fa-hourglass-half"></i> Pending Purchases (<span id="pending-count">0</span>)
                </h5>
                <div id="pending-container" class="table-responsive d-none">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Request ID</th>
                                <th>Email</th>
                                <th>Plan</th>
                                <th>Price</th>
                                <th>Created</th>
                                <th>Message</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="pending-body"></tbody>
                    </table>
                </div>
                <div id="pending-empty" class="alert alert-info m-0">
                    <i class="fas fa-check-circle"></i> Loading pending requests...
                </div>
            </div>
        </div>
        
        <div class="mt-4 text-muted border-top pt-3">
            <small><i class="fas fa-database"></i> Keys are stored globally in Cloudflare distributed memory. Modification functionality maps directly to serverless route callbacks.</small>
        </div>
    </div>
</Layout>

<!-- Load the cleanly separated dashboard script logic -->
<script is:inline src="/js/admin_keys.js"></script>
