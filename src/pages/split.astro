---
// src/pages/split.astro
import Layout from '../layouts/Layout.astro';
---
<Layout 
    title="Join-PDFs | Split PDF Files Online - Free Tool" 
    description="Split PDF into separate pages or extract specific pages. Divide large PDF documents into smaller files. Free online PDF splitting tool."
>
    <!-- Content Security Policy Bypasses & Security Fallbacks -->
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; worker-src 'self' blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://googletagmanager.com https://jsdelivr.net https://cloudflareinsights.com https://cloudflare.com https://unpkg.com https://cloudflare.com; connect-src 'self' https://*.google-analytics.com https://join-pdfs.com https://*.pages.dev https://cloudflareinsights.com https://*.cloudflareinsights.com; img-src 'self' data: https://*.google-analytics.com https://googletagmanager.com; style-src 'self' 'unsafe-inline' https://cloudflare.com; font-src 'self' data: https://cloudflare.com; frame-ancestors 'none'; form-action 'self';" slot="extra-head" />

    <!-- Page Specific Stylesheet -->
    <link rel="stylesheet" href="/css/split.css" slot="extra-head" />

    <!-- Header -->
    <div class="page-header">
        <h2><i class="fas fa-cut"></i> Split PDF Files</h2>
        <p class="subtitle">Upload a PDF and split it into multiple documents</p>
    </div>

    <!-- Info Grid -->
    <div class="info-grid">
        <div class="info-box">
            <i class="fas fa-file-upload"></i>
            <p><strong>Upload PDF</strong></p>
            <p class="small">50MB maximum</p>
        </div>
        <div class="info-box">
            <i class="fas fa-cog"></i>
            <p><strong>Choose Pages</strong></p>
            <p class="small">Select specific pages or ranges</p>
        </div>
        <div class="info-box">
            <i class="fas fa-download"></i>
            <p><strong>Download Results</strong></p>
            <p class="small">Get separate PDF files</p>
        </div>
    </div>

    <!-- Stats Bar -->
    <div class="stats-bar" id="statsBar" style="display: none;">
        <div class="stat">
            <span class="stat-label">File</span>
            <span id="fileName" class="stat-value">No file</span>
        </div>
        <div class="stat">
            <span class="stat-label">Size</span>
            <span id="fileSize" class="stat-value">0 MB</span>
        </div>
        <div class="stat">
            <span class="stat-label">Pages</span>
            <span id="totalPages" class="stat-value">0</span>
        </div>
    </div>

    <!-- Upload Zone -->
    <div class="upload-zone" id="uploadZone" style="cursor: pointer;">
        <div class="upload-icon">
            <i class="fas fa-file-upload"></i>
        </div>
        <h3>Drop PDF file here or click to browse</h3>
        <p>Select a PDF file to split into multiple documents</p>
        <input type="file" id="fileInput" accept=".pdf" style="display: none;" />
        <button class="btn-primary" id="browseBtn" type="button">
            <i class="fas fa-folder-open"></i> Browse Files
        </button>
    </div>

    <!-- Action Buttons -->
    <div class="action-buttons">
        <button id="clearBtn" class="btn-secondary" disabled>
            <i class="fas fa-trash-alt"></i> Clear File
        </button>
        <button id="processSplitBtn" class="btn-primary" disabled>
            <i class="fas fa-cut"></i> Split PDF
        </button>
    </div>

    <!-- Split Options Section (Hidden Initially) -->
    <section class="split-options-section" id="splitOptions" style="display: none;">
        <div class="section-header">
            <h3><i class="fas fa-cogs"></i> Split Options</h3>
            <span id="pageCount" class="badge">0 pages</span>
        </div>

        <div class="split-methods">
            <div class="split-method active" data-method="range">
                <div class="method-header">
                    <i class="fas fa-sliders-h"></i>
                    <h4>Split by Page Range</h4>
                </div>
                <p>Select specific page ranges (e.g., 1-3, 5-7)</p>
                <div id="rangeSettings" class="range-settings-panel">
                    <div class="range-inputs">
                        <div class="range-input-group">
                            <label for="fromPage">From Page:</label>
                            <input type="number" id="fromPage" min="1" value="1" placeholder="1" />
                        </div>
                        <div class="range-input-group">
                            <label for="toPage">To Page:</label>
                            <input type="number" id="toPage" min="1" value="1" placeholder="1" />
                        </div>
                        <button id="addRangeBtn" class="btn-small" type="button">
                            <i class="fas fa-plus"></i> Add Range
                        </button>
                    </div>
                    <div id="rangesList" class="ranges-list"></div>
                </div>
            </div>

            <div class="split-method" data-method="single">
                <div class="method-header">
                    <i class="fas fa-file-export"></i>
                    <h4>Extract Single Pages</h4>
                </div>
                <p>Extract individual pages as separate files</p>
                <div id="customSelectionSettings" class="custom-selection-panel" style="display: none;">
                    <div class="page-selection">
                        <div id="pagesGrid" class="pages-grid"></div>
                        <div class="page-controls">
                            <button id="selectAllBtn" class="btn-small" type="button">
                                <i class="fas fa-check-square"></i> Select All
                            </button>
                            <button id="clearSelectionBtn" class="btn-small" type="button">
                                <i class="fas fa-square"></i> Clear All
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Selected Pages Preview -->
    <section class="preview-section" id="selectionPreview" style="display: none;">
        <div class="section-header">
            <h3><i class="fas fa-eye"></i> Selection Preview</h3>
            <div class="badge" id="selectedCount">0 pages selected</div>
        </div>

        <div class="preview-content">
            <div class="preview-info">
                <div class="info-row">
                    <span class="info-label">Pages to extract:</span>
                    <span id="selectedPagesList" class="info-value">None</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Total files to create:</span>
                    <span id="filesCount" class="info-value">0</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Progress Overlay -->
    <div id="progressOverlay" class="progress-overlay" style="display: none;">
        <div class="progress-content">
            <div class="spinner">
                <div class="spinner-circle"></div>
            </div>
            <h3>Processing...</h3>
            <p id="progressFile">Splitting PDF file</p>
            <div class="progress-bar">
                <div class="progress-fill" id="progressFill"></div>
            </div>
            <p class="progress-text">
                <span id="progressText">Starting split...</span>
                <span id="progressPercent">0%</span>
            </p>
        </div>
    </div>

    <!-- Success Overlay -->
    <div id="successOverlay" class="success-overlay" style="display: none;">
        <div class="success-content">
            <i class="fas fa-check-circle success-icon"></i>
            <h3>Split Complete!</h3>
            <p>Your PDF has been successfully split</p>

            <div class="success-stats">
                <div class="stat-item">
                    <i class="fas fa-file-alt"></i>
                    <span>Files Created: <strong id="filesCreated">0</strong></span>
                </div>
                <div class="stat-item">
                    <i class="fas fa-copy"></i>
                    <span>Total Pages: <strong id="totalPagesProcessed">0</strong></span>
                </div>
                <div class="stat-item">
                    <i class="fas fa-weight-hanging"></i>
                    <span>Processing Time: <strong id="processingTime">0s</strong></span>
                </div>
            </div>

            <div class="success-buttons">
                <a id="downloadLink" class="btn-download" href="#">
                    <i class="fas fa-download"></i> Download Results (ZIP)
                </a>
                <button id="newSplitBtn" class="btn-secondary" type="button">
                    <i class="fas fa-redo"></i> Split Another PDF
                </button>
            </div>
        </div>
    </div>

    <!-- Toast Notifications -->
    <div id="toastContainer" class="toast-container"></div>

    <!-- Upgrade CTA Section -->
    <div class="upgrade-cta" style="margin: 40px 0; padding: 25px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 12px; color: white; text-align: left;">
        <div style="display: flex; align-items: center; gap: 20px; flex-wrap: wrap;">
            <div style="flex: 1; min-width: 280px;">
                <h3 style="color: white; margin: 0 0 10px 0;">Need More Than Conversion?</h3>
                <p style="margin: 0; opacity: 0.9;">Our free tool splits your documents securely, but what if you need to:</p>
                <ul style="margin: 10px 0 0 0; padding-left: 20px;">
                    <li>Edit text directly in PDFs?</li>
                    <li>Add e-signatures or annotations?</li>
                    <li>Convert scanned documents with OCR?</li>
                    <li>Process 100+ files at once?</li>
                </ul>
            </div>
            <div style="text-align: center; min-width: 200px; margin-top: 10px;">
                <a href="/pdf-comparison" style="display: inline-block; background: white; color: #667eea; padding: 12px 30px; border-radius: 30px; text-decoration: none; font-weight: bold; transition: all 0.3s;">
                    Compare Premium Solutions →
                </a>
                <p style="margin: 10px 0 0 0; font-size: 14px; opacity: 0.8;">Find the right tool for advanced needs</p>
            </div>
        </div>
    </div>
</Layout>

<!-- Core browser-side functionality execution modules from public folder -->
<script is:inline src="/js/split.js"></script>
