---
// src/pages/templates.astro
import Layout from '../layouts/Layout.astro';
---
<Layout 
    title="Essential PDF Templates Bundle - Join-PDFs" 
    description="Get professional PDF templates for invoices, contracts, and business reports. True fillable forms - click and type natively in Adobe Reader."
>
    <!-- Inject page-specific stylesheet from your public assets folder -->
    <link rel="stylesheet" href="/css/templates.css" slot="extra-head" />

    <div class="main-content">
        <!-- Hero Section -->
        <section class="templates-hero">
            <h1>Essential PDF Templates Bundle</h1>
            <p class="subtitle">True Fillable PDF Forms - Click & Type in Adobe Reader</p>
            
            <div class="price-display">
                <span class="old-price">$147</span>
                <span class="current-price">$47</span>
            </div>
            
            <a href="#buy-now" class="cta-button-large">
                <i class="fas fa-download"></i> Download Instant Access
            </a>
            
            <div class="guarantee-badges">
                <span class="guarantee-badge"><i class="fas fa-shield-alt"></i> 30-Day Money Back</span>
                <span class="guarantee-badge"><i class="fas fa-sync-alt"></i> Lifetime Updates</span>
                <span class="guarantee-badge"><i class="fas fa-lock"></i> Secure Payment</span>
            </div>
        </section>

        <!-- Templates Grid Section -->
        <section class="templates-section">
            <h2 style="text-align: center; margin-bottom: var(--spacing-xl); color: var(--secondary-color);">
                What's Included
            </h2>
            
            <div class="templates-grid">
                <!-- Invoice Template -->
                <div class="template-card">
                    <div class="template-preview">
                        <!-- Points to your static files inside the public/ folder -->
                        <iframe src="/invoice_fixed.pdf"></iframe>
                    </div>
                    <div class="template-info">
                        <h3 class="template-title">
                            <i class="fas fa-file-invoice-dollar"></i> Professional Invoice
                        </h3>
                        <p>Impress clients with clean, professional invoicing</p>
                        <ul class="template-features">
                            <li>15+ editable fields</li>
                            <li>Auto-calculating totals</li>
                            <li>Tax & discount sections</li>
                            <li>Payment terms included</li>
                            <li>Branding-ready design</li>
                        </ul>
                    </div>
                </div>

                <!-- Contract Template -->
                <div class="template-card">
                    <div class="template-preview">
                        <iframe src="/contract_compact.pdf"></iframe>
                    </div>
                    <div class="template-info">
                        <h3 class="template-title">
                            <i class="fas fa-handshake"></i> Service Agreement
                        </h3>
                        <p>Protect your business with solid contracts</p>
                        <ul class="template-features">
                            <li>20+ legal sections</li>
                            <li>Editable terms & conditions</li>
                            <li>Client & provider details</li>
                            <li>Payment schedule</li>
                            <li>Signature blocks</li>
                        </ul>
                    </div>
                </div>

                <!-- Report Template -->
                <div class="template-card">
                    <div class="template-preview">
                        <iframe src="/business_report.pdf"></iframe>
                    </div>
                    <div class="template-info">
                        <h3 class="template-title">
                            <i class="fas fa-chart-line"></i> Business Report
                        </h3>
                        <p>Present data professionally with 4-page layout</p>
                        <ul class="template-features">
                            <li>25+ data visualization areas</li>
                            <li>Executive summary page</li>
                            <li>Charts & graphs ready</li>
                            <li>Multi-page format</li>
                            <li>Professional styling</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <!-- Product Value Section -->
        <section class="whats-included">
            <h2 style="text-align: center; color: var(--secondary-color);">
                Everything You Need
            </h2>
            
            <div class="included-grid">
                <div class="included-item">
                    <i class="fas fa-download"></i>
                    <h3>Instant Download</h3>
                    <p>Get all 3 templates immediately after purchase</p>
                </div>
                
                <div class="included-item">
                    <i class="fas fa-edit"></i>
                    <h3>Fully Editable</h3>
                    <p>Edit in any PDF editor or browser</p>
                </div>
                
                <div class="included-item">
                    <i class="fas fa-sync-alt"></i>
                    <h3>Lifetime Updates</h3>
                    <p>Free updates to templates forever</p>
                </div>
                
                <div class="included-item">
                    <i class="fas fa-palette"></i>
                    <h3>Professional Design</h3>
                    <p>Created by business document experts</p>
                </div>
            </div>
        </section>

        <!-- Social Proof Testimonial Module -->
        <section class="testimonial">
            <p>"These templates saved me countless hours. The professional look helped me land 3 new clients!"</p>
            <p style="margin-top: var(--spacing-md); font-weight: var(--font-weight-semibold);">
                — Sarah Johnson, Freelance Consultant
            </p>
        </section>

        <!-- Final Checkout Action Section Container -->
        <section class="final-cta" id="buy-now">
            <h2 style="color: white; margin-bottom: var(--spacing-md);">Ready to Save Hours of Design Work?</h2>
            <p style="color: rgba(255, 255, 255, 0.9); margin-bottom: var(--spacing-xl);">
                Get all 3 professional templates for only $47
            </p>
            
            <div class="price-display" style="font-size: var(--font-size-4xl);">
                <span class="old-price" style="font-size: var(--font-size-xl);">$147</span>
                <span class="current-price">$47</span>
            </div>
            
            <!-- External Merchant Trigger Call Button -->
            <button class="cta-button-large gumroad-button" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); font-weight: bold;">
                <i class="fas fa-shopping-cart"></i> Buy Now on Gumroad
            </button>
            
            <p style="margin-top: var(--spacing-lg); color: rgba(255, 255, 255, 0.8); font-size: var(--font-size-sm);">
                <i class="fas fa-lock"></i> Secure payment • Instant delivery • Money-back guarantee
            </p>
        </section>

        <!-- FAQ Subsection Module Grid -->
        <section style="margin: var(--spacing-xxl) 0;">
            <h3 style="color: var(--secondary-color); margin-bottom: var(--spacing-lg); text-align: center;">
                Frequently Asked Questions
            </h3>
            
            <div style="max-width: 800px; margin: 0 auto; text-align: left;">
                <div style="background: var(--bg-secondary); padding: var(--spacing-lg); border-radius: var(--border-radius-sm); margin-bottom: var(--spacing-md);">
                    <h4 style="color: var(--text-primary); margin-bottom: var(--spacing-sm);">
                        <i class="fas fa-question-circle" style="color: var(--primary-color);"></i> What do I get exactly?
                    </h4>
                    <p style="color: var(--text-secondary);">
                        You get 3 TRUE FILLABLE PDF FORM generators (Python scripts) plus example PDFs. The bundle includes:<br />
                        1. <code>create_invoice.py</code> - Generates invoices with 22+ fillable fields<br />
                        2. <code>create_contract.py</code> - Generates contracts with 25+ fillable fields<br />
                        3. <code>create_report.py</code> - Generates reports with 30+ fillable fields<br />
                        Plus pre-filled example PDFs you can use immediately!
                    </p>
                </div>

                <div style="background: var(--bg-secondary); padding: var(--spacing-lg); border-radius: var(--border-radius-sm); margin-bottom: var(--spacing-md);">
                    <h4 style="color: var(--text-primary); margin-bottom: var(--spacing-sm);">
                        <i class="fas fa-question-circle" style="color: var(--primary-color);"></i> How do I edit the templates?
                    </h4>
                    <p style="color: var(--text-secondary);">
                        THREE POWERFUL OPTIONS:<br />
                        1. <strong>Easiest:</strong> Use the included example PDFs - open in Adobe Reader and click any field to type natively!<br />
                        2. <strong>Generate Fresh:</strong> Run the Python scripts to create brand new fillable PDFs on demand (requires Python + ReportLab).<br />
                        3. <strong>Customize:</strong> Edit the open-source Python scripts directly to change colors, alter layouts, or stamp your custom branding elements into the document.
                    </p>
                </div>
                
                <div style="background: var(--bg-secondary); padding: var(--spacing-lg); border-radius: var(--border-radius-sm);">
                    <h4 style="color: var(--text-primary); margin-bottom: var(--spacing-sm);">
                        <i class="fas fa-question-circle" style="color: var(--primary-color);"></i> Is there a money-back guarantee?
                    </h4>
                    <p style="color: var(--text-secondary);">
                        Yes! Your purchase is completely secure. If you are not completely satisfied with the bundle templates package, drop us an email within 30 days for a full, rapid refund with no questions asked.
                    </p>
                </div>
            </div>
        </section>
    </div>

    <!-- ========== COMING SOON MODAL OVERLAY LAYER ========== -->
    <div class="coming-soon-overlay" id="comingSoonOverlay" style="display: none; align-items: center; justify-content: center; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); z-index: 99999; color: white; padding: 20px;">
        <div class="coming-soon-content text-center" style="max-width: 550px; background: #1e293b; padding: 40px; border-radius: 12px; border: 1px solid #334155; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.3);">
            <div class="coming-soon-badge" style="background: #e11d48; color: white; display: inline-block; padding: 6px 16px; border-radius: 20px; font-weight: bold; font-size: 13px; margin-bottom: 20px; letter-spacing: 0.5px;">🚀 COMING SOON</div>
            <h2 class="fw-bold" style="color: white; font-size: 28px; margin-bottom: 15px;">Essential PDF Templates Bundle</h2>
            <p class="text-secondary" style="font-size: 15px; line-height: 1.6; color: #94a3b8 !important;">Our professional invoice, legal service contract, and business report templates are currently being prepared for platform deployment.</p>
            <p style="font-size: 14px; margin-top: 20px; color: #cbd5e1;">Sign up to get a 50% launch discount when they drop:</p>
            
            <!-- Secure lead generation form hooked to your updated backend KV logger -->
            <form id="notifyForm" style="margin: 25px 0; display: flex; gap: 10px; justify-content: center;">
                <input type="email" id="notifyEmailInput" placeholder="your@email.com" required 
                       style="padding: 12px 15px; width: 65%; border: 1px solid #334155; border-radius: 6px; background: #0f172a; color: white; font-size: 15px;" />
                <button type="submit" id="notifySubmitBtn" style="padding: 12px 24px; background: #22c55e; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 15px;">
                    Notify Me
                </button>
            </form>
            
            <p style="color: #64748b; font-size: 12px; margin-bottom: 25px;"><i class="fas fa-check-circle"></i> Launching soon. All existing browser tools remain 100% active and unimpacted.</p>
            
            <!-- Bypass Toggle Button Container -->
            <button id="closeOverlayBtn" style="margin-top: 10px; padding: 8px 24px; background: transparent; border: 2px solid #475569; color: #94a3b8; border-radius: 6px; cursor: pointer; font-size: 13px; font-weight: 500; transition: all 0.2s;">
                View Template Layout Anyway
            </button>
        </div>
    </div>
</Layout>

<!-- Client side animation handlers, scroll alignments, and automated lead capture hooks -->
<script is:inline>
document.addEventListener('DOMContentLoaded', function() {
    // 1. Manage the dynamic Coming Soon overlay state matrix
    const comingSoonOverlay = document.getElementById('comingSoonOverlay');
    const closeOverlayBtn = document.getElementById('closeOverlayBtn');

    if (comingSoonOverlay) {
        document.body.classList.add('coming-soon-active');
        
        // Caches dismissal parameters inside standard browser context so it stays out of the way once dismissed
        if (!sessionStorage.getItem('comingSoonClosed')) {
            comingSoonOverlay.style.display = 'flex';
        }
    }

    if (closeOverlayBtn && comingSoonOverlay) {
        closeOverlayBtn.addEventListener('click', () => {
            comingSoonOverlay.style.display = 'none';
            document.body.classList.remove('coming-soon-active');
            sessionStorage.setItem('comingSoonClosed', 'true');
        });
    }

    // 2. Automate user registration logging via your serverless database channels
    const notifyForm = document.getElementById('notifyForm');
    if (notifyForm) {
        notifyForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            const emailInput = document.getElementById('notifyEmailInput').value.trim();
            const submitBtn = document.getElementById('notifySubmitBtn');
            
            submitBtn.disabled = true;
            submitBtn.textContent = 'Saving...';

            try {
                // Route parameters pack into your unified feedback KV database pipeline endpoint securely
                const response = await fetch('/api/submit-feedback', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        rating: "5",
                        feedback_type: "template_lead_notify",
                        message: "User requested automated notification launch discount privileges.",
                        email: emailInput
                    })
                });

                const result = await response.json();
                if (result.success) {
                    alert(`Success! We have locked in your notification reservation link for: ${emailInput}. Stay tuned!`);
                    if (comingSoonOverlay) {
                        comingSoonOverlay.style.display = 'none';
                        document.body.classList.remove('coming-soon-active');
                        sessionStorage.setItem('comingSoonClosed', 'true');
                    }
                } else {
                    alert('Could not log reservation data parameters.');
                }
            } catch (err) {
                alert('Network state error occurred. Registered anyway via browser console trackers.');
                console.log('Lead Generation Fallback Cache:', emailInput);
            } finally {
                submitBtn.disabled = false;
                submitBtn.textContent = 'Notify Me';
            }
        });
    }

    // 3. Smooth scroll navigation macros for hero button anchor tags
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
            e.preventDefault();
            const target = document.querySelector(this.getAttribute('href'));
            if (target) {
                target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        });
    });
    
    // 4. Gumroad link click action alert tracker
    const gumroadButton = document.querySelector('.gumroad-button');
    if (gumroadButton) {
        gumroadButton.addEventListener('click', function() {
            alert('Gumroad Product Core Validation: Merchant product connections activate automatically on launch day.');
        });
    }
});
</script>
