---
// src/pages/flipbook.astro
import Layout from '../layouts/Layout.astro';
---
<Layout 
    title="3D Digital Flipbook Previewer - Join-PDFs" 
    description="Turn your flat PDF documents into interactive 3D digital flipbooks right inside your web browser. Free, lightning fast, and client-side processing."
>
    <!-- Wire local configuration style and engine bindings -->
    <link href="/css/flipbook.css" rel="stylesheet" slot="extra-head" />
    <script src="/js/flipbook.js" is:inline slot="extra-head"></script>


    <div class="flipbook-container text-start">
        <h1 class="flipbook-title">📖 3D Digital Flipbook Previewer</h1>
        <p class="text-muted">Transform static documents into stylized, animated turn-page digital spreads with zero registration required.</p>
        
        <!-- Document Selection Target Portal -->
        <div class="drop-zone" id="dropZone" style="border: 3px dashed #dee2e6; border-radius: 10px; padding: 4rem 1rem; text-align: center; background: #f8f9fa; cursor: pointer;">
            <i class="fas fa-book-open fa-3x mb-3 text-secondary" style="display:block;"></i>
            <span class="fw-semibold text-dark">Select or Drop PDF Document</span>
            <input type="file" id="fileInput" accept="application/pdf" style="display: none;" />
        </div>

        <!-- 3D Perspective Animation Canvas Stage Container -->
        <div class="stage-wrapper" style="position: relative;">
            <div class="book-viewport" id="bookViewport" style="display: none;"></div>

            <!-- Floating Fullscreen Control HUD -->
            <div class="fs-controls-hud" id="fsHud">
                <button class="btn-hud" id="fsPrevBtn">← Prev</button>
                <div class="zoom-panel bg-dark text-white border-0 m-0">
                    <!-- HUD Accessibility Zoom Buttons -->
                    <button class="btn-zoom-adjust text-white" id="fsZoomOutBtn" style="background:transparent; border:0; padding:0 5px; cursor:pointer;">➖</button>
                    <input type="range" id="fsZoomSlider" class="zoom-slider" min="0.8" max="4.0" step="0.1" value="1.4" />
                    <button class="btn-zoom-adjust text-white" id="fsZoomInBtn" style="background:transparent; border:0; padding:0 5px; cursor:pointer;">➕</button>
                    <span id="fsZoomLabel" class="small fw-bold text-white ms-1" style="min-width: 45px; display: inline-block; text-align: right;">140%</span>
                </div>
                <button class="btn-hud" id="fsNextBtn">Next →</button>
                <button class="btn-hud btn-exit-fs" id="fsExitBtn">✕ Exit Fullscreen</button>
            </div>
        </div>

        <!-- Desktop Navigation Spread Buttons & Zoom Footer Matrix -->
        <div class="nav-controls" style="display: none; margin-top: 2rem; justify-content: center; gap: 1rem; align-items: center; flex-wrap: wrap; position: relative; z-index: 99999; background: rgba(255, 255, 255, 0.9); padding: 1rem; border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.03); max-width: 950px; margin-left: auto; margin-right: auto;">
            <button class="btn-nav" id="prevBtn">← Previous Page</button>
            
            <!-- Zoom Panel Slider Control with Fixed Layer Isolation -->
            <div class="zoom-panel" style="position: relative; z-index: 100000; display: inline-flex; align-items: center; background: #f1f3f5; padding: 0.4rem 1rem; border-radius: 20px;">
                <button class="btn-zoom-adjust text-muted" id="zoomOutBtn" style="background:transparent; border:0; padding:0 10px; cursor:pointer; font-size: 1.2rem;">➖</button>
                <input type="range" id="zoomSlider" class="zoom-slider" min="0.7" max="4.0" step="0.1" value="1.0" style="accent-color: #ff5d01; cursor: pointer; width: 120px;" />
                <button class="btn-zoom-adjust text-muted" id="zoomInBtn" style="background:transparent; border:0; padding:0 10px; cursor:pointer; font-size: 1.2rem;">➕</button>
                <span id="zoomLabel" class="small fw-bold text-dark ms-1" style="min-width: 45px; display: inline-block; text-align: right;">100%</span>
            </div>

            <!-- Fullscreen Button Trigger -->
            <button class="btn-nav" id="fullscreenBtn" style="background: #0d6efd; color: white; display: inline-flex; align-items: center; gap: 0.5rem; border: none; padding: 0.5rem 1.5rem; border-radius: 4px; cursor: pointer; font-weight: 500;">
                🖥️ Fullscreen Mode
            </button>

            <span id="pageNumLabel" class="fw-semibold text-muted" style="min-width: 120px; display: inline-block;">Spread 1 / 1</span>
            <button class="btn-nav" id="nextBtn">Next Page →</button>
            
            <button class="btn-reset" id="resetBtn" style="background: #dc3545; color: white; border: none; padding: 0.5rem 1.25rem; border-radius: 4px; cursor: pointer; font-weight: 500; margin-left: 1.5rem; position: relative; z-index: 100000;">
                ✕ Close & New
            </button>
        </div>

    </div>


</Layout>
