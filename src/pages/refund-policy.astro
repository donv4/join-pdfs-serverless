---
// src/pages/refund-policy.astro
import Layout from '../layouts/Layout.astro';
---
<Layout 
    title="Refund Policy - Join-PDFs" 
    description="Review the 14-day refund eligibility guidelines, Paddle support procedures, and buyer terms for premium access transactions on Join-PDFs."
>
    <!-- Injecting local, lightning-fast static assets into the head slot -->
    <link href="/css/refund_policy.css" rel="stylesheet" slot="extra-head" />
    <script src="/js/refund_policy.js" is:inline slot="extra-head"></script>

    <div class="policy-container">
        <h1 class="policy-title">
            <span class="icon-wrap">↩️</span> Refund Policy
        </h1>
        
        <p class="policy-lead">We offer a 14-day, no-questions-asked refund policy on all premium purchases made through our primary merchant partner Paddle.</p>
        
        <!-- Eligibility Card -->
        <div class="policy-card">
            <div class="card-body">
                <h5 class="card-subtitle"><span class="icon-success">✅</span> Refund Eligibility</h5>
                <ul class="card-list">
                    <li>Refunds are available within <strong>14 days</strong> of initial checkout purchase.</li>
                    <li>No questions asked—simply request a refund through Paddle and it will be processed promptly.</li>
                    <li>Refund parameters are always returned directly back to the original payment source method.</li>
                </ul>
            </div>
        </div>

        <!-- Procedures Card -->
        <div class="policy-card">
            <div class="card-body">
                <h5 class="card-subtitle"><span class="icon-primary">ℹ️</span> How to Request a Refund</h5>
                <p class="small-text">To process an automated reverse transaction:</p>
                <ol class="card-list-ordered">
                    <li>Contact Paddle support directly at <a href="https://paddle.com" target="_blank" class="link-primary">Paddle Buyer Support Portal</a>.</li>
                    <li>Provide your official digital order invoice receipt or standard transaction ID string.</li>
                    <li>Refund items typically credit back onto your processing balance within 5–10 standard business days.</li>
                </ol>
            </div>
        </div>

        <!-- Contact Card -->
        <div class="policy-card">
            <div class="card-body">
                <h5 class="card-subtitle"><span class="icon-secondary">✉️</span> Contact Us</h5>
                <p class="card-text">If you run into issues or have edge-case questions regarding this refund structure, please loop our desk directly at:</p>
                <p class="contact-email"><strong>Operations Email:</strong> <a href="mailto:support@join-pdfs.com" class="link-primary">support@join-pdfs.com</a></p>
            </div>
        </div>

        <p class="policy-footer"><span class="icon-scale">⚖️</span> This policy is fully mapped and aligned with the official <a href="https://paddle.com" target="_blank" class="footer-link">Paddle Buyer Protection Guidelines</a>.</p>
    </div>
</Layout>
