---
// src/pages/batch-process.astro
import Layout from '../layouts/Layout.astro';
import 'bootstrap/dist/css/bootstrap.min.css';
---

<Layout 
    title="Batch PDF Processing | Join-PDFs" 
    description="Process up to 50 PDF files simultaneously with our premium batch processing suite. Fast, secure, and fully browser-automated."
>

    <div class="container py-5" style="background: rgba(255,255,255,0.9); border-radius: 12px; margin-top: 40px; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
        <h1 class="mb-4 text-primary"><i class="fas fa-bolt"></i> Batch PDF Processing</h1>
        <p class="lead text-muted mb-4">Process up to 50 PDF files at once (Premium Feature)</p>

        <div class="row g-4">
            <!-- Left Side: Interactive Upload Form -->
            <div class="col-md-6">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-primary text-white py-3">
                        <h4 class="m-0"><i class="fas fa-cloud-upload-alt"></i> Upload Batch</h4>
                    </div>
                    <div class="card-body p-4">
                        <form id="batchForm">
                            <div class="mb-3">
                                <label class="form-label fw-bold text-secondary">Premium Key</label>
                                <input type="text" class="form-control" id="premiumKeyInput" name="premium_key" placeholder="Enter your premium key" required>
                                <small class="text-muted d-block mt-1">Already have a key? Enter it here. Need one? <a href="/pricing" class="text-primary fw-semibold">See pricing below ↓</a></small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold text-secondary">ZIP File with PDFs</label>
                                <input type="file" class="form-control" name="zip_file" accept=".zip" required>
                                <small class="text-muted d-block mt-1">Maximum 50 PDF files, 100MB total</small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold text-secondary">Action</label>
                                <select class="form-select" name="action">
                                    <option value="compress">Compress all PDFs</option>
                                    <option value="merge">Merge into single PDF</option>
                                    <option value="split">Split all PDFs</option>
                                    <option value="convert_to_word">Convert to Word</option>
                                </select>
                            </div>

                            <button type="submit" id="submitBtn" class="btn btn-success btn-lg w-100 mt-2">
                                🚀 Process Batch
                            </button>
                        </form>

                        <!-- Progress Container (Initially Hidden) -->
                        <div id="progressContainer" class="mt-4" style="display: none;">
                            <div class="alert alert-info border-0 shadow-sm m-0">
                                <h5 class="alert-heading mb-2"><i class="fas fa-sync fa-spin"></i> Processing Batch</h5>
                                <div class="progress mb-2" style="height: 25px;">
                                    <div id="progressBar" class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 0%">0%</div>
                                </div>
                                <div class="d-flex align-items-center justify-content-between">
                                    <span id="progressText" class="small fw-semibold">Starting...</span>
                                    <div class="spinner-border spinner-border-sm text-primary" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Result Container -->
                        <div id="result" class="mt-3"></div>
                    </div>
                </div>
            </div>

            <!-- Right Side: Marketing & Pricing Copy -->
            <div class="col-md-6">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-info text-white py-3">
                        <h4 class="m-0"><i class="fas fa-crown"></i> Premium Benefits</h4>
                    </div>
                    <div class="card-body p-4">
                        <ul class="list-group list-group-flush mb-4">
                            <li class="list-group-item px-0"><i class="fas fa-check text-success me-2"></i> Process 50 files simultaneously</li>
                            <li class="list-group-item px-0"><i class="fas fa-check text-success me-2"></i> Save hours of manual work</li>
                            <li class="list-group-item px-0"><i class="fas fa-check text-success me-2"></i> Priority processing queue</li>
                            <li class="list-group-item px-0"><i class="fas fa-check text-success me-2"></i> 4 most popular tools in batch mode</li>
                            <li class="list-group-item px-0"><i class="fas fa-check text-success me-2"></i> Compress, Merge, Split & Convert to Word</li>
                            <li class="list-group-item px-0"><i class="fas fa-check text-success me-2"></i> ZIP in → ZIP out convenience</li>
                        </ul>

                        <div id="premium-section">
                            <div class="alert alert-light border border-info p-4 m-0" style="border-radius: 8px;">
                                <h5 class="text-info mb-3"><i class="fas fa-crown"></i> Premium Feature</h5>
                                <p class="text-muted small">Batch processing requires an active premium key to unlock secure network computing cycles.</p>
                                
                                <div class="mt-3">
                                    <h6 class="fw-bold text-secondary">Premium includes:</h6>
                                    <ul class="mb-3 ps-3 small text-muted">
                                        <li class="mb-1">Process 50+ files at once</li>
                                        <li class="mb-1">All 4 batch tools unlocked</li>
                                        <li class="mb-1">Priority local browser pipeline acceleration</li>
                                        <li class="mb-1">No annoying upload delays</li>
                                        <li>Full access + Audio/Video extractor tools</li>
                                    </ul>
                                </div>
                                
                                <div class="text-center mt-4">
                                    <a href="/pricing" class="btn btn-primary btn-lg px-4 fw-bold">
                                        <i class="fas fa-crown"></i> View Plans & Pricing
                                    </a>
                                    <p class="text-muted mt-2 small mb-0">
                                        Premium keys are delivered instantly via email after payment.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</Layout>

<script is:inline src="/js/batch_process.js"></script>
